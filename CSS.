/* styles.css */
body {
    margin: 0;
    overflow: hidden;
    background-color: #000;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
}

#galaxy-container {
    position: relative;
    width: 100%;
    height: 100%;
}

#galaxy {
    position: absolute;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.star {
    position: absolute;
    background-color: white;
    border-radius: 50%;
    animation: twinkle 2s infinite alternate;
}

@keyframes twinkle {
    from {
        opacity: 0.2;
    }
    to {
        opacity: 0.8;
    }
}

.core {
    position: absolute;
    width: 50px;
    height: 50px;
    background-color: #FFD700;
    border-radius: 50%;
    box-shadow: 0 0 20px #FFD700;
}

.arm {
    position: absolute;
    background-color: #4169E1;
    border-radius: 50%;
    opacity: 0.7;
}
